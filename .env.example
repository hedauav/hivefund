# ---- Testnet root account (created by a human via faucet; never commit real keys) ----
ROOT_ACCOUNT=
ROOT_PRIVATE_KEY=

# ---- Agent function-call access keys (ed25519:..., written by scripts/setup-testnet.ts into .env.local) ----
COORDINATOR_KEY=
VERIFIER_KEY=
WORKER_CHEAP_KEY=
WORKER_QUALITY_KEY=
WORKER_ADAPTIVE_KEY=
WORKER_FORGER_KEY=

# ---- Separate ed25519 bid-signing keys (public half registered on-chain via add_worker) ----
WORKER_CHEAP_BID_KEY=
WORKER_QUALITY_BID_KEY=
WORKER_ADAPTIVE_BID_KEY=
WORKER_FORGER_BID_KEY=

# ---- NEAR AI Cloud (optional; without a key the verifier/workers use deterministic fallbacks) ----
NEARAI_API_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_MODEL=z-ai/glm-5.3-flash
# per-worker generation models (defaults shown; verifier rubric uses NEARAI_MODEL)
WORKER_CHEAP_MODEL=z-ai/glm-5.3-flash
WORKER_ADAPTIVE_MODEL=z-ai/glm-5.3-flash
WORKER_QUALITY_MODEL=deepseek/deepseek-v3.2

# ---- Runtime ----
HIVEFUND_DATA_DIR=./data
# testnet | mock  (testnet = real chain + real NEAR AI; mock = in-memory chain, no LLM: simulation mode for tests)
HIVEFUND_MODE=testnet
# set to 1 to run the testnet-gated e2e/role tests (npm run test:testnet sets it)
HIVEFUND_E2E_TESTNET=

# ---- Web ----
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_HUB_CONTRACT=
NEXT_PUBLIC_TOKEN_CONTRACT=

# ---- Testnet setup budgets (scripts/setup-testnet.ts; all NEAR, minimal defaults) ----
# Contract accounts default to ceil(wasm_bytes / 100 KB) NEAR + CONTRACT_STATE_BUFFER_NEAR
HUB_FUND_NEAR=
HIVE_FUND_NEAR=
CONTRACT_STATE_BUFFER_NEAR=0.2
AGENT_FUND_NEAR=0.1
FC_ALLOWANCE_NEAR=0.05
TREASURY_FUND_NEAR=0.5
TREASURY_CAP_NEAR=1
MINT_RATE=10000000000000000
GAS_MARGIN_NEAR=0.3
# root = ROOT's public key stays on agent accounts as a human-held recovery key (enables `topup.ts rekey`); none = FC key only
AGENT_RECOVERY_KEY=root
# optional overrides
HUB_PREFIX=hub
TOKEN_PREFIX=hive
RPC_URL=https://test.rpc.fastnear.com
RPC_FALLBACK_URL=https://near-testnet.drpc.org
