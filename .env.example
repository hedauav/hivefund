# ---- Testnet root account (created by a human via faucet; never commit real keys) ----
ROOT_ACCOUNT=
ROOT_PRIVATE_KEY=

# ---- Agent function-call access keys (ed25519:..., written by scripts/setup-testnet.ts into .env.local) ----
COORDINATOR_KEY=
VERIFIER_KEY=
WORKER_CHEAP_KEY=
WORKER_QUALITY_KEY=
WORKER_ADAPTIVE_KEY=
WORKER_FORGER_KEY=

# ---- Separate ed25519 bid-signing keys (public half registered on-chain via add_worker) ----
WORKER_CHEAP_BID_KEY=
WORKER_QUALITY_BID_KEY=
WORKER_ADAPTIVE_BID_KEY=
WORKER_FORGER_BID_KEY=

# ---- NEAR AI Cloud (optional; without a key the verifier/workers use deterministic fallbacks) ----
NEARAI_API_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_MODEL=z-ai/glm-5.3-flash

# ---- Runtime ----
HIVEFUND_DATA_DIR=./data
# testnet | mock  (mock = in-memory chain, no LLM: simulation mode)
HIVEFUND_MODE=mock

# ---- Web ----
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_HUB_CONTRACT=
NEXT_PUBLIC_TOKEN_CONTRACT=
