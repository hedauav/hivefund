{
  "name": "hivefund",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HiveFund: a community bounty market on NEAR where AI worker agents compete, a verifier gates payment, and the market mints HIVE from verified outcomes.",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.2"
  },
  "workspaces": [
    "agents/*",
    "web",
    "tests"
  ],
  "scripts": {
    "demo": "tsx agents/coordinator/src/demo.ts",
    "test": "npm -w tests test",
    "setup:testnet": "tsx scripts/setup-testnet.ts",
    "web": "npm -w web run dev",
    "typecheck:shared": "tsc --noEmit -p agents/shared"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
